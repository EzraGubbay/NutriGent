  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "clean": "npm run clean:cache && npm run clean:ios",
    "clean:cache": "npx expo start --clear",
    "clean:ios": "cd ios && rm -rf Pods Podfile.lock && cd ..",
    "clean:all": "rm -rf node_modules ios/Pods ios/Podfile.lock package-lock.json && npm install && cd ios && pod install && cd ..",
    "doctor": "npx expo-doctor"
  },
